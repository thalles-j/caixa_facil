{
  "name": "caixafacil",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names BACKEND,FRONTEND --prefix-colors magenta,cyan --prefix \"[{name}]\" \"npm run dev:backend\" \"wait-on --timeout 30000 http-get://127.0.0.1:3000/api/health && npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:validate": "npm run prisma:validate --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "prisma:deploy": "npm run prisma:deploy --workspace backend",
    "seed": "npm run seed --workspace backend",
    "seed:reset": "npm run seed --workspace backend -- --reset"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
