generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String               @unique @db.Citext
  passwordHash        String               @map("password_hash")
  name                String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  passwordResetTokens PasswordResetToken[]
  categories          Category[]
  products            Product[]
  customers           Customer[]
  cashSessions        CashSession[]
  sales               Sale[]
  saleItems           SaleItem[]
  fixedExpenses       FixedExpense[]
  creditSales         CreditSale[]
  transactions        Transaction[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_password_reset_tokens_user_created")
  @@map("password_reset_tokens")
}

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([userId, id], map: "uq_categories_tenant_id")
  @@map("categories")
}

model Product {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  categoryId       String?                 @map("category_id") @db.Uuid
  kind             String                  @default("product")
  name             String
  salePrice        Decimal                 @default(0) @map("sale_price") @db.Decimal(14, 2)
  costPrice        Decimal                 @default(0) @map("cost_price") @db.Decimal(14, 2)
  stockQuantity    Decimal?                @map("stock_quantity") @db.Decimal(14, 3)
  minimumQuantity  Decimal?                @map("minimum_quantity") @db.Decimal(14, 3)
  serviceDuration  Unsupported("interval")? @map("service_duration")
  active           Boolean                 @default(true)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         Category?               @relation(fields: [userId, categoryId], references: [userId, id], onDelete: Restrict)
  saleItems        SaleItem[]

  @@unique([userId, id], map: "uq_products_tenant_id")
  @@index([userId, active], map: "idx_products_user_active")
  @@index([userId, categoryId], map: "idx_products_user_category")
  @@map("products")
}

model Customer {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  name        String
  phone       String?
  email       String?      @db.Citext
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales       Sale[]
  creditSales CreditSale[]

  @@unique([userId, id], map: "uq_customers_tenant_id")
  @@map("customers")
}

model CashSession {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  responsible     String
  openedAt        DateTime      @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt        DateTime?     @map("closed_at") @db.Timestamptz(6)
  openingBalance  Decimal       @default(0) @map("opening_balance") @db.Decimal(14, 2)
  closingBalance  Decimal?      @map("closing_balance") @db.Decimal(14, 2)
  expectedBalance Decimal?      @map("expected_balance") @db.Decimal(14, 2)
  difference      Decimal?      @default(dbgenerated()) @db.Decimal(14, 2)
  status          String        @default("open")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales           Sale[]
  transactions    Transaction[]

  @@unique([userId, id], map: "uq_cash_sessions_tenant_id")
  @@index([userId, openedAt(sort: Desc)], map: "idx_cash_sessions_user_opened")
  @@map("cash_sessions")
}

model Sale {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  cashSessionId  String?       @map("cash_session_id") @db.Uuid
  customerId     String?       @map("customer_id") @db.Uuid
  description    String?
  paymentMethod  String        @map("payment_method")
  status         String        @default("completed")
  totalAmount    Decimal       @map("total_amount") @db.Decimal(14, 2)
  soldAt         DateTime      @default(now()) @map("sold_at") @db.Timestamptz(6)
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashSession    CashSession?  @relation(fields: [userId, cashSessionId], references: [userId, id], onDelete: Restrict)
  customer       Customer?     @relation(fields: [userId, customerId], references: [userId, id], onDelete: Restrict)
  items          SaleItem[]
  creditSale     CreditSale?
  transactions   Transaction[]

  @@unique([userId, id], map: "uq_sales_tenant_id")
  @@index([userId, soldAt(sort: Desc)], map: "idx_sales_user_sold")
  @@index([userId, cashSessionId, soldAt(sort: Desc)], map: "idx_sales_user_session_sold")
  @@index([userId, customerId, soldAt(sort: Desc)], map: "idx_sales_user_customer_sold")
  @@index([userId, paymentMethod, status], map: "idx_sales_user_payment_status")
  @@map("sales")
}

model SaleItem {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  saleId      String       @map("sale_id") @db.Uuid
  productId   String?      @map("product_id") @db.Uuid
  productName String       @map("product_name")
  quantity    Decimal      @db.Decimal(14, 3)
  unitPrice   Decimal      @map("unit_price") @db.Decimal(14, 2)
  unitCost    Decimal      @default(0) @map("unit_cost") @db.Decimal(14, 2)
  totalAmount Decimal?     @default(dbgenerated()) @map("total_amount") @db.Decimal(14, 2)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sale        Sale         @relation(fields: [userId, saleId], references: [userId, id], onDelete: Cascade)
  product     Product?     @relation(fields: [userId, productId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, id], map: "uq_sale_items_tenant_id")
  @@index([userId, saleId], map: "idx_sale_items_user_sale")
  @@index([userId, productId], map: "idx_sale_items_user_product")
  @@map("sale_items")
}

model FixedExpense {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  description   String
  amount        Decimal       @db.Decimal(14, 2)
  recurrence    String        @default("monthly")
  startsOn      DateTime      @default(now()) @map("starts_on") @db.Date
  endsOn        DateTime?     @map("ends_on") @db.Date
  nextDueDate   DateTime?     @map("next_due_date") @db.Date
  dueDay        Int?          @map("due_day") @db.SmallInt
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([userId, id], map: "uq_fixed_expenses_tenant_id")
  @@index([userId, active, nextDueDate], map: "idx_fixed_expenses_user_active_due")
  @@map("fixed_expenses")
}

model CreditSale {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  saleId       String        @map("sale_id") @db.Uuid
  customerId   String        @map("customer_id") @db.Uuid
  amount       Decimal       @db.Decimal(14, 2)
  paidAmount   Decimal       @default(0) @map("paid_amount") @db.Decimal(14, 2)
  status       String        @default("pendente")
  dueDate      DateTime?     @map("due_date") @db.Date
  paidAt       DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sale         Sale          @relation(fields: [userId, saleId], references: [userId, id], onDelete: Restrict)
  customer     Customer      @relation(fields: [userId, customerId], references: [userId, id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([userId, id], map: "uq_credit_sales_tenant_id")
  @@unique([userId, saleId], map: "uq_credit_sales_tenant_sale")
  @@index([userId, status, dueDate], map: "idx_credit_sales_user_status_due")
  @@index([userId, customerId, status], map: "idx_credit_sales_user_customer_status")
  @@index([userId, createdAt(sort: Desc)], map: "idx_credit_sales_user_created")
  @@map("credit_sales")
}

model Transaction {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String         @map("user_id") @db.Uuid
  cashSessionId         String?        @map("cash_session_id") @db.Uuid
  saleId                String?        @map("sale_id") @db.Uuid
  fixedExpenseId        String?        @map("fixed_expense_id") @db.Uuid
  creditSaleId          String?        @map("credit_sale_id") @db.Uuid
  type                  String
  source                String
  paymentMethod         String         @default("dinheiro") @map("payment_method")
  amount                Decimal        @db.Decimal(14, 2)
  description           String?
  movementKind          String         @default("regular") @map("movement_kind")
  entryKind             String?        @map("entry_kind")
  expenseKind           String?        @map("expense_kind")
  identificationPending Boolean        @default(false) @map("identification_pending")
  occurredAt            DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashSession           CashSession?   @relation(fields: [userId, cashSessionId], references: [userId, id], onDelete: Restrict)
  sale                  Sale?          @relation(fields: [userId, saleId], references: [userId, id], onDelete: Restrict)
  fixedExpense          FixedExpense?  @relation(fields: [userId, fixedExpenseId], references: [userId, id], onDelete: Restrict)
  creditSale            CreditSale?    @relation(fields: [userId, creditSaleId], references: [userId, id], onDelete: Restrict)

  @@unique([userId, id], map: "uq_transactions_tenant_id")
  @@index([userId, occurredAt(sort: Desc)], map: "idx_transactions_user_occurred")
  @@index([userId, cashSessionId, occurredAt(sort: Desc)], map: "idx_transactions_user_session_occurred")
  @@index([userId, source, occurredAt(sort: Desc)], map: "idx_transactions_user_source_occurred")
  @@map("transactions")
}
