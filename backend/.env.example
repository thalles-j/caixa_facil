NODE_ENV=development
PORT=3000

# Neon > Project dashboard > Connect. A URL pooled e suficiente para este
# projeto e deve terminar em sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@EP-EXAMPLE-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
# Opcional: se sua conta disponibilizar uma URL direta, ela sera preferida
# apenas para aplicar o DDL. Remova/deixe comentada se voce usa somente pooled.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@EP-EXAMPLE.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace-me-too

# Lista exata de origens, separada por virgula.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Em producao, execute `npm run db:schema` no release/deploy. Ative isto apenas
# quando nao houver uma etapa de release separada.
RUN_DB_MIGRATIONS_ON_STARTUP=false
